# Shazam music recognition
# iOS: enable ShazamKit for App ID com.gixza.lyricvid in Apple Developer.
# Android: add credentials/shazam.properties (developerToken, or teamId + keyId + privateKey).
# Optional pre-made Android JWT:
# EXPO_PUBLIC_SHAZAM_DEVELOPER_TOKEN=

EXPO_PUBLIC_SHAZAM_CLIP_SECONDS=12
EXPO_PUBLIC_SHAZAM_ENABLED=true
